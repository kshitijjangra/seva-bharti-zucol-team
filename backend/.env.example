# Copy to .env and fill in. NEVER commit real values.

# Postgres connection (use a least-privilege app role in production — see rules.md)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/seva_bharti
# Max DB connections per server instance
DATABASE_POOL_MAX=10

# 32+ random chars. Generate: openssl rand -hex 32
PAYLOAD_SECRET=

# This CMS backend's own origin (admin + REST API) — CORS/CSRF allow-list and absolute media URLs
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# Optional extra comma-separated origins allowed to call the CMS API (FRONTEND_URL is always allowed)
EXTRA_ALLOWED_ORIGINS=

# Production media storage (Vercel Blob). Leave empty locally to use ./media
BLOB_READ_WRITE_TOKEN=

# Optional SMTP for password-reset emails (required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Sewa Bharti CMS

# Number of trusted reverse proxies in front of a SELF-HOSTED server (ignored on Vercel)
TRUSTED_PROXY_HOPS=0

# LOCAL DEV ONLY — never set these in production
# Auto-sync DB schema without migrations
PAYLOAD_DB_PUSH=
# Allow the one-time "create first admin" screen over HTTP
ALLOW_FIRST_REGISTER=

# Frontend app (public site) origin: target of the cache-revalidation webhook
# (POST {FRONTEND_URL}/api/revalidate), "View live site" link, CORS/CSRF allow-list.
# Leave empty to disable the webhook.
FRONTEND_URL=http://localhost:3000
# Shared secret for the revalidation webhook (must match frontend REVALIDATE_SECRET). 32+ random chars.
REVALIDATE_SECRET=
# Shared key the frontend server sends as x-frontend-key on API reads so it bypasses the
# per-IP API read limit (must match frontend FRONTEND_API_KEY). 32+ random chars.
FRONTEND_API_KEY=
