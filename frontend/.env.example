# Backend (Payload CMS) base URL — server-side only, never NEXT_PUBLIC_
CMS_URL=http://localhost:3001
# Shared secret for POST /api/revalidate (must match backend REVALIDATE_SECRET). 32+ random chars.
REVALIDATE_SECRET=
# Shared key sent as x-frontend-key on API reads (must match backend FRONTEND_API_KEY). 32+ random chars.
FRONTEND_API_KEY=
# Set to 1 only for a database-less "frontend only" deploy that reads src/content-snapshot/data.json
CMS_SNAPSHOT=
